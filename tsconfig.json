{
  "include": ["scripts", "packages", "apps"],
  "exclude": ["node_modules", "packages/*/{lib,esm,cjs}/**/*"],
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2015",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noEmitOnError": true,
    "allowJs": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {}
  }
}
